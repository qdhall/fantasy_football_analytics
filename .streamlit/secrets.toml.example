league_id = 00000000
espn_s2 = "your-espn_s2-cookie-value"
swid = "{your-swid-cookie-value}"

# Optional - only needed for the durable R2 cache layer (see espn_data.py's
# _r2_client_and_bucket). Without these, the app falls back to local-disk-only
# caching, which is fine for local dev but gets wiped on every Streamlit Cloud
# redeploy/sleep-wake.
r2_account_id = "your-cloudflare-account-id"
r2_access_key_id = "your-r2-access-key-id"
r2_secret_access_key = "your-r2-secret-access-key"
r2_bucket = "your-bucket-name"

# Required for the Matchup Predictor page's Vegas-odds signal (player props +
# game lines). Free tier at sportsgameodds.com.
sportsgameodds_api_key = "your-sportsgameodds-api-key"

# Required for db.py (see schema.sql) - a Supabase Postgres connection
# string. Use the "Session pooler" mode specifically, not "Direct
# connection" - Supabase's direct connection resolves IPv6-only, which
# works from a machine with IPv6 egress (most home networks) but fails
# outright ("Network is unreachable") from hosts that don't have it,
# Render included. The session pooler is IPv4-compatible and works
# everywhere. Project Settings -> Database -> Connection String -> Session
# pooler on supabase.com. Note the username becomes "postgres.<project-ref>"
# in this mode, not plain "postgres".
supabase_db_url = "postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres"
